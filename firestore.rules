// PERAVAI — Firestore Security Rules
// ──────────────────────────────────────────────────────────────────────────────
// IMPORTANT: The primary data access layer is Express + Firebase Admin SDK.
// These rules act as a DEFENSE-IN-DEPTH layer — they deny direct client access
// to sensitive collections even if someone bypasses the backend.
// The backend must still perform all authorization checks independently.
// ──────────────────────────────────────────────────────────────────────────────

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────

    // Is the request from an authenticated user?
    function isAuthenticated() {
      return request.auth != null;
    }

    // Is the requesting user the owner of this document?
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Does the user's Custom Claim include an admin role?
    function hasAdminClaim() {
      return isAuthenticated() &&
        (request.auth.token.role == 'admin' || request.auth.token.role == 'organizer');
    }

    // ── /users ────────────────────────────────────────────────────────────────
    // Users can read their own profile. Only backend (Admin SDK) can write.
    match /users/{uid} {
      allow read: if isOwner(uid) || hasAdminClaim();
      allow write: if false; // All writes go through the Express backend
    }

    // ── /events ───────────────────────────────────────────────────────────────
    // Anyone authenticated can read events. Only admins can write.
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow write: if false; // Backend only
    }

    // ── /registrations ────────────────────────────────────────────────────────
    // Users can read their own registration. Backend handles all writes.
    // Admins (gate scanner) can read ANY registration to perform check-in.
    match /registrations/{registrationId} {
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        hasAdminClaim() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
      // Allow admin to write check-in fields directly from the scanner (Client SDK)
      allow update: if isAuthenticated() && (
        hasAdminClaim() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
      allow create, delete: if false; // All creates/deletes go through backend
    }

    // ── /teams ────────────────────────────────────────────────────────────────
    // Authenticated users can read teams (needed for team discovery/joining).
    // All writes go through the backend to enforce business rules.
    match /teams/{teamId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ── /team_members ─────────────────────────────────────────────────────────
    match /team_members/{memberId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // ── /tickets ──────────────────────────────────────────────────────────────
    // Users can read only their own tickets.
    match /tickets/{ticketId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // ── /payments ─────────────────────────────────────────────────────────────
    // Users can read their own payment records. No direct writes.
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // ── /attendance ───────────────────────────────────────────────────────────
    // Attendance is fully admin-managed. No direct client access.
    match /attendance/{attendanceId} {
      allow read:  if hasAdminClaim();
      allow write: if false;
    }

    // ── /announcements ────────────────────────────────────────────────────────
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ── /notifications ────────────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // ── /auditLogs ────────────────────────────────────────────────────────────
    match /auditLogs/{logId} {
      allow read:  if hasAdminClaim();
      allow write: if false; // Internal backend use only
    }

    // ── /problem_statements ───────────────────────────────────────────────────
    // Read-only for authenticated users.
    match /problem_statements/{psId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ── /config ───────────────────────────────────────────────────────────────
    // Admin-only config (e.g. currentDay for gate scanner).
    match /config/{configId} {
      allow read: if isAuthenticated() && (
        hasAdminClaim() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
      allow write: if false;
    }

    // ── DEFAULT: deny everything not explicitly listed ────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
